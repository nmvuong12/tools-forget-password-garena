# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN VERCEL API SCHEDULER
# ========================================================

# --- API 1 (Garena Recovery Init) ---
API1_URL="https://account.garena.com/api/account/recovery/init"
API1_ACCOUNT="nghjalsss"
API1_APP_ID="100001"
API1_SOURCE="account center"

# --- API 2 (Garena Send OTP hoặc tương tự) ---
API2_URL="https://account.garena.com/api/account/recovery/send_otp"
API2_ACTION="1"
API2_DATA="84123456789"

# --- VƯỢT TƯỜNG LỬA DATADOME (GARENA) ---
# Lấy từ F12 Network tab trên trình duyệt, dán toàn bộ chuỗi Cookie vào đây:
GARENA_COOKIE=""

USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# --- BẢO MẬT VERCEL CRON ---
CRON_SECRET="your_random_secret_key_here"

# --- HEADERS BỔ SUNG (TÙY CHỌN) ---
EXTRA_HEADERS_JSON="{}"
